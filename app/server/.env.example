NODE_ENV=local
LOGGER_LEVEL=DEBUG
SERVER_URL=http://localhost:3002

# optional query string appended to document URLs in query output,
# with no leading '?' (e.g. ref=eq-download)
DOCUMENT_URL_QUERY_STRING=

# local database
DB_NAME=
DB_PORT=
DB_HOST=
DB_SSL=

# local database read-only user
DB_USERNAME=
DB_PASSWORD=

# performance related
DB_POOL_MIN=5
DB_POOL_MAX=20
STREAM_BATCH_SIZE=2000
STREAM_HIGH_WATER_MARK=10000
MAX_QUERY_SIZE=1000000
MAX_PAGE_SIZE=500

# optional database guards, in milliseconds
DB_CONNECTION_TIMEOUT=
DB_STATEMENT_TIMEOUT=
DB_IDLE_IN_TRANSACTION_TIMEOUT=

# optional ms of no write progress before abandoning a streaming response
STREAM_IDLE_TIMEOUT=

# EQ API keys
EQ_API_KEY=
EQ_API_SIGNUP_KEY=
EQ_DATA_API_URL=
